```lua
-- ══════════════════════════════════════════════════════════════════════
--  Fe UGC Animations Studio v3.0 — ULTRA EDITION
--  Neon Glass UI • Live Search • Auto-Sync • Presets • Toast System
-- ══════════════════════════════════════════════════════════════════════

local Players        = game:GetService("Players")
local AssetService   = game:GetService("AssetService")
local AvatarEditor   = game:GetService("AvatarEditorService")
local RunService     = game:GetService("RunService")
local HttpService    = game:GetService("HttpService")
local ContentProv    = game:GetService("ContentProvider")
local TweenService   = game:GetService("TweenService")
local UserInput      = game:GetService("UserInputService")
local LP             = Players.LocalPlayer

-- ─── Files ────────────────────────────────────────────────────────────
local F_CACHE     = "fua3_cache.json"
local F_EQUIPPED  = "fua3_equipped.json"
local F_PRESETS   = "fua3_presets.json"
local F_BOOKMARKS = "fua3_bookmarks.json"
local CACHE_URL   = "https://raw.githubusercontent.com/TribalFootball/TuffTeto/main/animation_bundle_data_cache.json"

-- ─── Slots ────────────────────────────────────────────────────────────
local SLOT_TO_FOLDER = {
    idleanimation="idle", walkanimation="walk", runanimation="run",
    jumpanimation="jump", fallanimation="fall", climbanimation="climb",
    swimidleanimation="swimidle", swimanimation="swim",
}
local SLOT_LABELS = {
    idleanimation="Idle", walkanimation="Walk", runanimation="Run",
    jumpanimation="Jump", fallanimation="Fall", climbanimation="Climb",
    swimidleanimation="S.Idle", swimanimation="Swim",
}
local SLOT_ORDER = {
    "idleanimation","walkanimation","runanimation","jumpanimation",
    "fallanimation","climbanimation","swimidleanimation","swimanimation"
}
local SLOT_ICONS = {
    idleanimation="🧍", walkanimation="🚶", runanimation="🏃",
    jumpanimation="⬆", fallanimation="⬇", climbanimation="🧗",
    swimidleanimation="🏊", swimanimation="🌊",
}

-- ─── Palette — Deep Neon Glass ─────────────────────────────────────────
local C = {
    bg0     = Color3.fromRGB(8,   10,  18),
    bg1     = Color3.fromRGB(12,  15,  26),
    bg2     = Color3.fromRGB(18,  22,  38),
    bg3     = Color3.fromRGB(24,  30,  52),
    bg4     = Color3.fromRGB(32,  40,  68),
    card    = Color3.fromRGB(20,  25,  44),
    cardHi  = Color3.fromRGB(30,  38,  62),
    glass   = Color3.fromRGB(255,255,255),

    neon    = Color3.fromRGB(80,  160, 255),
    neon2   = Color3.fromRGB(120, 80,  255),
    neonG   = Color3.fromRGB(60,  220, 140),
    neonP   = Color3.fromRGB(200, 80,  255),
    neonR   = Color3.fromRGB(255, 70,  90),
    gold    = Color3.fromRGB(255, 210, 60),
    orange  = Color3.fromRGB(255, 140, 50),

    textHi  = Color3.fromRGB(240, 244, 255),
    textMid = Color3.fromRGB(160, 170, 210),
    textLo  = Color3.fromRGB(80,  90,  130),
    stroke  = Color3.fromRGB(40,  50,  90),
    strokeHi= Color3.fromRGB(80,  100, 180),
    white   = Color3.new(1,1,1),
    black   = Color3.new(0,0,0),
    overlay = Color3.fromRGB(5,   7,   14),
}

-- ─── Scale ────────────────────────────────────────────────────────────
local VP    = workspace.CurrentCamera.ViewportSize
local SCALE = math.clamp(math.min(VP.X/1920, VP.Y/1080)*1.55, 0.52, 2.0)
local function px(n) return math.round(n*SCALE) end

-- ─── Storage ──────────────────────────────────────────────────────────
local function jRead(f)
    if not(isfile and isfile(f)) then return {} end
    local ok,r = pcall(readfile,f)
    if not ok or not r or r=="" then return {} end
    local ok2,t = pcall(HttpService.JSONDecode,HttpService,r)
    return (ok2 and type(t)=="table") and t or {}
end
local function jWrite(f,d)
    pcall(function() writefile(f,HttpService:JSONEncode(d)) end)
end

-- ─── State ────────────────────────────────────────────────────────────
local S = {
    cache=jRead(F_CACHE), equipped=jRead(F_EQUIPPED),
    presets=jRead(F_PRESETS), bookmarks=jRead(F_BOOKMARKS),
    rCache={},
    tab="Animations", searchList={}, catCursor=nil,
    page=1, perPage=8,
    bundleId=nil, bundleName="None", bundleItems={},
    selSlot="idleanimation", masterTrack=nil, masterGen=0,
    renameIdx=nil, gridThreads={},
    notifQueue={}, notifBusy=false,
}
if type(S.presets)~="table"   then S.presets={}   end
if type(S.equipped)~="table"  then S.equipped={}  end
if type(S.bookmarks)~="table" then S.bookmarks={} end

-- Online cache sync
task.spawn(function()
    local ok,raw = pcall(game.HttpGet,game,CACHE_URL)
    if not ok or not raw then return end
    local ok2,online = pcall(HttpService.JSONDecode,HttpService,raw)
    if not ok2 or type(online)~="table" then return end
    local changed=false
    for k,v in pairs(online) do
        if not S.cache[k] then S.cache[k]=v; changed=true end
    end
    if changed then jWrite(F_CACHE,S.cache) end
end)

-- ═══════════════════════════════════════════════════════════════════════
--  ANIMATION ENGINE
-- ═══════════════════════════════════════════════════════════════════════

local function fetchAnims(assetId, assetType)
    local sid = tostring(assetId)
    if S.rCache[sid] then return S.rCache[sid] end
    if S.cache[sid] then
        local list={}
        for _,d in ipairs(S.cache[sid]) do
            local a=Instance.new("Animation")
            a.Name,a.AnimationId=d.Name,d.AnimationId
            table.insert(list,a)
        end
        S.rCache[sid]=list; return list
    end
    local lower=string.lower(assetType or "")
    local prop="IdleAnimation"
    if lower:find("walk") then prop="WalkAnimation"
    elseif lower:find("run") then prop="RunAnimation"
    elseif lower:find("jump") then prop="JumpAnimation"
    elseif lower:find("fall") then prop="FallAnimation"
    elseif lower:find("climb") then prop="ClimbAnimation"
    elseif lower:find("swim") then prop="SwimAnimation"
    end
    local result,serial={},{}
    pcall(function()
        local desc=Instance.new("HumanoidDescription")
        desc[prop]=tonumber(assetId)
        local dummy=Players:CreateHumanoidModelFromDescription(desc,Enum.HumanoidRigType.R15)
        local ani=dummy:FindFirstChild("Animate")
        if ani then
            local folders=(prop=="SwimAnimation") and {"swim","swimidle"}
                or {string.lower(prop:gsub("Animation",""))}
            for _,fn in ipairs(folders) do
                local folder=ani:FindFirstChild(fn)
                if folder then
                    for _,child in ipairs(folder:GetChildren()) do
                        if child:IsA("Animation") and child.AnimationId~="" then
                            local c2=child:Clone()
                            table.insert(result,c2)
                            table.insert(serial,{Name=c2.Name,AnimationId=c2.AnimationId})
                        end
                    end
                end
            end
        end
        dummy:Destroy()
    end)
    if #result==0 then
        pcall(function()
            local objs=game:GetObjects("rbxassetid://"..sid)
            if objs and #objs>0 then
                local function tryAdd(item)
                    if item:IsA("Animation") then
                        table.insert(result,item:Clone())
                        table.insert(serial,{Name=item.Name,AnimationId=item.AnimationId})
                    end
                end
                tryAdd(objs[1])
                for _,d in ipairs(objs[1]:GetDescendants()) do tryAdd(d) end
            end
        end)
    end
    S.rCache[sid]=result; S.cache[sid]=serial
    jWrite(F_CACHE,S.cache)
    return result
end

local function clearCache(id)
    local sid=tostring(id)
    S.rCache[sid]=nil; S.cache[sid]=nil
    jWrite(F_CACHE,S.cache)
end

local function pickTrack(tracks,slotType)
    if #tracks==0 then return nil end
    local lt=string.lower(slotType or "")
    if lt=="swimidleanimation" then
        for _,t in ipairs(tracks) do
            if string.lower(t.Name):find("idle") then return t end
        end
        return tracks[2] or tracks[1]
    end
    return tracks[1]
end

local function applySlot(char,slotType,animList)
    local animate=char:FindFirstChild("Animate")
    local human=char:FindFirstChildOfClass("Humanoid")
    if not animate or not human then return end
    for _,tr in ipairs(human:GetPlayingAnimationTracks()) do
        pcall(function() tr:AdjustWeight(0,0); tr:Stop(0) end)
    end
    animate.Disabled=true
    local fn=SLOT_TO_FOLDER[string.lower(slotType)]
    if fn then
        local folder=animate:FindFirstChild(fn)
        if folder then
            for _,c2 in ipairs(folder:GetChildren()) do
                if c2:IsA("Animation") then c2:Destroy() end
            end
            S.equipped[string.lower(slotType)]={}
            for _,anim in ipairs(animList) do
                local na=Instance.new("Animation",folder)
                na.Name,na.AnimationId=anim.Name,anim.AnimationId
                table.insert(S.equipped[string.lower(slotType)],
                    {Name=anim.Name,AnimationId=anim.AnimationId})
            end
            jWrite(F_EQUIPPED,S.equipped)
        end
    end
    task.wait(0.05); animate.Disabled=false
end

local function applyAllEquipped(char)
    if not char then return end
    local animate=char:WaitForChild("Animate",6)
    local human=char:WaitForChild("Humanoid",6)
    if not animate or not human then return end
    local idle=animate:FindFirstChild("idle")
    if idle then idle:WaitForChild("Animation1",4) end
    task.wait(0.15)
    for _,tr in ipairs(human:GetPlayingAnimationTracks()) do
        pcall(function() tr:AdjustWeight(0,0); tr:Stop(0) end)
    end
    animate.Disabled=true
    for slotType,animDataList in pairs(S.equipped) do
        local fn=SLOT_TO_FOLDER[slotType]
        if fn then
            local folder=animate:FindFirstChild(fn)
            if folder then
                for _,c2 in ipairs(folder:GetChildren()) do
                    if c2:IsA("Animation") then c2:Destroy() end
                end
                for _,d in ipairs(animDataList) do
                    local na=Instance.new("Animation",folder)
                    na.Name,na.AnimationId=d.Name,d.AnimationId
                end
            end
        end
    end
    task.wait(0.05); animate.Disabled=false
end

local function onCharAdded(char)
    task.spawn(function()
        if next(S.equipped) then applyAllEquipped(char) end
    end)
end
if LP.Character then task.spawn(onCharAdded,LP.Character) end
LP.CharacterAdded:Connect(onCharAdded)

-- ═══════════════════════════════════════════════════════════════════════
--  UI ENGINE
-- ═══════════════════════════════════════════════════════════════════════

local guiParent=(typeof(gethui)=="function" and gethui()) or game:GetService("CoreGui")
if guiParent:FindFirstChild("FUA3") then guiParent.FUA3:Destroy() end

local Screen=Instance.new("ScreenGui",guiParent)
Screen.Name="FUA3"; Screen.ResetOnSpawn=false
Screen.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
Screen.DisplayOrder=999

-- ── Primitives ────────────────────────────────────────────────────────
local function mkCorner(p,r)
    local c2=Instance.new("UICorner",p)
    c2.CornerRadius=UDim.new(0,r or px(8)); return c2
end
local function mkStroke(p,col,thick,trans)
    local s=Instance.new("UIStroke",p)
    s.Color=col or C.stroke; s.Thickness=thick or 1
    s.Transparency=trans or 0; return s
end
local function mkPad(p,t,b,l,r)
    local u=Instance.new("UIPadding",p)
    u.PaddingTop=UDim.new(0,t or 0); u.PaddingBottom=UDim.new(0,b or 0)
    u.PaddingLeft=UDim.new(0,l or 0); u.PaddingRight=UDim.new(0,r or 0)
end
local function tw(obj,t2,goals,style,dir)
    return TweenService:Create(obj,
        TweenInfo.new(t2,style or Enum.EasingStyle.Quint,
            dir or Enum.EasingDirection.Out),goals)
end
local function trunc(s2,n) return (#s2>n) and (s2:sub(1,n-1).."…") or s2 end

-- Neon glow effect
local function mkGlow(parent,color,size)
    local g=Instance.new("ImageLabel",parent)
    g.Size=UDim2.new(1,size or px(20),1,size or px(20))
    g.Position=UDim2.new(0,-(size or px(10))/2,0,-(size or px(10))/2)
    g.BackgroundTransparency=1
    g.Image="rbxassetid://7072725342"
    g.ImageColor3=color or C.neon
    g.ImageTransparency=0.7
    g.ZIndex=parent.ZIndex-1
    return g
end

-- Animated gradient
local function mkAnimGrad(parent,c0,c1,speed)
    local g=Instance.new("UIGradient",parent)
    g.Color=ColorSequence.new({
        ColorSequenceKeypoint.new(0,c0),
        ColorSequenceKeypoint.new(0.5,c1),
        ColorSequenceKeypoint.new(1,c0),
    })
    g.Rotation=45; g.Offset=Vector2.new(-1,0)
    TweenService:Create(g,TweenInfo.new(speed or 2,
        Enum.EasingStyle.Linear,Enum.EasingDirection.InOut,-1),
        {Offset=Vector2.new(1,0)}):Play()
    return g
end

local function shimmer(f,cA,cB)
    local old=f:FindFirstChild("_shim"); if old then old:Destroy() end
    local g=mkAnimGrad(f,cA,cB,1.6); g.Name="_shim"; return g
end
local function noShimmer(f)
    local g=f:FindFirstChild("_shim"); if g then g:Destroy() end
end

-- Hover
local function hover(btn,norm,hi)
    btn.MouseEnter:Connect(function() tw(btn,0.15,{BackgroundColor3=hi}):Play() end)
    btn.MouseLeave:Connect(function() tw(btn,0.15,{BackgroundColor3=norm}):Play() end)
end

-- ── Dimensions ────────────────────────────────────────────────────────
local WIN_W   = px(760)
local WIN_H   = px(510)
local TITLE_H = px(52)
local LEFT_W  = px(310)
local RIGHT_W = WIN_W - LEFT_W - px(12)
local VP_H    = px(185)

-- ═══════════════════════════════════════════════════════════════════════
--  MAIN WINDOW
-- ═══════════════════════════════════════════════════════════════════════

local Win=Instance.new("Frame",Screen)
Win.Name="Win"
Win.Size=UDim2.fromOffset(WIN_W,WIN_H)
Win.Position=UDim2.new(0.5,-WIN_W/2,0.5,-WIN_H/2)
Win.BackgroundColor3=C.bg1
Win.BorderSizePixel=0
Win.ClipsDescendants=true
mkCorner(Win,px(16))

-- Multi-layer glass background
local bgLayer1=Instance.new("Frame",Win)
bgLayer1.Size=UDim2.new(1,0,1,0)
bgLayer1.BackgroundColor3=C.bg0
bgLayer1.BackgroundTransparency=0
bgLayer1.BorderSizePixel=0

local bgGrad=Instance.new("UIGradient",bgLayer1)
bgGrad.Color=ColorSequence.new({
    ColorSequenceKeypoint.new(0,Color3.fromRGB(14,18,35)),
    ColorSequenceKeypoint.new(0.5,Color3.fromRGB(8,10,20)),
    ColorSequenceKeypoint.new(1,Color3.fromRGB(16,20,40)),
})
bgGrad.Rotation=135

-- Neon border stroke
local winStroke=mkStroke(Win,C.neon,2,0.3)

-- Animated neon border
task.spawn(function()
    local colors={C.neon,C.neon2,C.neonG,C.neonP,C.neon}
    local idx=1
    while Win and Win.Parent do
        local next_idx=(idx%#colors)+1
        tw(winStroke,2,{Color=colors[next_idx]}):Play()
        idx=next_idx; task.wait(2)
    end
end)

-- ── Title Bar ─────────────────────────────────────────────────────────
local TBar=Instance.new("Frame",Win)
TBar.Name="TBar"; TBar.Size=UDim2.new(1,0,0,TITLE_H)
TBar.BackgroundColor3=C.bg2; TBar.BorderSizePixel=0
mkCorner(TBar,px(16))

local TBarFix=Instance.new("Frame",TBar)
TBarFix.Size=UDim2.new(1,0,0.5,0); TBarFix.Position=UDim2.new(0,0,0.5,0)
TBarFix.BackgroundColor3=C.bg2; TBarFix.BorderSizePixel=0

-- Title gradient line
local titleLine=Instance.new("Frame",TBar)
titleLine.Size=UDim2.new(1,0,0,px(2))
titleLine.Position=UDim2.new(0,0,1,-px(2))
titleLine.BackgroundColor3=C.neon; titleLine.BorderSizePixel=0
mkAnimGrad(titleLine,C.neon,C.neon2,3)

-- Logo
local LogoFrame=Instance.new("Frame",TBar)
LogoFrame.Size=UDim2.fromOffset(px(34),px(34))
LogoFrame.Position=UDim2.fromOffset(px(12),px(9))
LogoFrame.BackgroundColor3=C.neon; LogoFrame.BorderSizePixel=0
mkCorner(LogoFrame,px(10))
mkAnimGrad(LogoFrame,C.neon,C.neon2,2)

local LogoLbl=Instance.new("TextLabel",LogoFrame)
LogoLbl.Size=UDim2.new(1,0,1,0); LogoLbl.BackgroundTransparency=1
LogoLbl.Text="▶"; LogoLbl.TextColor3=C.white
LogoLbl.Font=Enum.Font.GothamBlack; LogoLbl.TextSize=px(14)

-- Title text with gradient
local TitleLbl=Instance.new("TextLabel",TBar)
TitleLbl.Size=UDim2.new(1,-px(160),0,px(26))
TitleLbl.Position=UDim2.fromOffset(px(54),px(6))
TitleLbl.BackgroundTransparency=1
TitleLbl.Text="Fe UGC Animations"
TitleLbl.TextColor3=C.textHi
TitleLbl.Font=Enum.Font.GothamBlack
TitleLbl.TextSize=px(16)
TitleLbl.TextXAlignment=Enum.TextXAlignment.Left

local SubLbl=Instance.new("TextLabel",TBar)
SubLbl.Size=UDim2.new(0.5,0,0,px(14))
SubLbl.Position=UDim2.fromOffset(px(54),px(32))
SubLbl.BackgroundTransparency=1
SubLbl.Text="Ultra Edition v3.0  •  Auto-Sync"
SubLbl.TextColor3=C.neon; SubLbl.Font=Enum.Font.Gotham; SubLbl.TextSize=px(9)
SubLbl.TextXAlignment=Enum.TextXAlignment.Left

-- Window controls
local function mkWCtrl(sym,xOff,bg,hiBg)
    local b=Instance.new("TextButton",TBar)
    b.Size=UDim2.fromOffset(px(24),px(24))
    b.Position=UDim2.new(1,xOff,0.5,-px(12))
    b.BackgroundColor3=bg; b.Text=sym; b.TextColor3=C.white
    b.Font=Enum.Font.GothamBold; b.TextSize=px(12)
    b.AutoButtonColor=false; mkCorner(b,px(12))
    hover(b,bg,hiBg); return b
end
local BtnClose=mkWCtrl("✕",-px(12),C.neonR,Color3.fromRGB(200,40,60))
local BtnMin=mkWCtrl("─",-px(42),C.bg4,C.cardHi)

-- ── Drag ──────────────────────────────────────────────────────────────
do
    local drag,dS,wS=false,nil,nil
    TBar.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then
            drag=true; dS=i.Position; wS=Win.Position
        end
    end)
    UserInput.InputChanged:Connect(function(i)
        if drag and i.UserInputType==Enum.UserInputType.MouseMovement then
            local d=i.Position-dS
            Win.Position=UDim2.fromOffset(wS.X.Offset+d.X,wS.Y.Offset+d.Y)
        end
    end)
    UserInput.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
    end)
end

-- ── Mini button ───────────────────────────────────────────────────────
local MiniBtn=Instance.new("Frame",Screen)
MiniBtn.Size=UDim2.fromOffset(px(70),px(70))
MiniBtn.Position=UDim2.new(1,-px(84),1,-px(84))
MiniBtn.BackgroundColor3=C.bg2
MiniBtn.Visible=false; MiniBtn.BorderSizePixel=0
mkCorner(MiniBtn,px(20))
mkStroke(MiniBtn,C.neon,2)
mkAnimGrad(MiniBtn,C.bg2,C.bg3,3)

local MiniBtnGlow=Instance.new("ImageLabel",MiniBtn)
MiniBtnGlow.Size=UDim2.new(1,px(20),1,px(20))
MiniBtnGlow.Position=UDim2.new(0,-px(10),0,-px(10))
MiniBtnGlow.BackgroundTransparency=1
MiniBtnGlow.Image="rbxassetid://7072725342"
MiniBtnGlow.ImageColor3=C.neon; MiniBtnGlow.ImageTransparency=0.5

local MiniBtnLbl=Instance.new("TextLabel",MiniBtn)
MiniBtnLbl.Size=UDim2.new(1,0,1,0); MiniBtnLbl.BackgroundTransparency=1
MiniBtnLbl.Text="UGC"; MiniBtnLbl.TextColor3=C.neon
MiniBtnLbl.Font=Enum.Font.GothamBlack; MiniBtnLbl.TextSize=px(13)

local MiniBtnHit=Instance.new("TextButton",MiniBtn)
MiniBtnHit.Size=UDim2.new(1,0,1,0); MiniBtnHit.BackgroundTransparency=1
MiniBtnHit.Text=""; MiniBtnHit.Draggable=true

BtnClose.MouseButton1Click:Connect(function()
    tw(Win,0.25,{Size=UDim2.fromOffset(0,0),
        Position=UDim2.new(0.5,0,0.5,0)},
        Enum.EasingStyle.Back,Enum.EasingDirection.In):Play()
    task.wait(0.27); Win.Visible=false; MiniBtn.Visible=true
end)
BtnMin.MouseButton1Click:Connect(function()
    Win.Visible=false; MiniBtn.Visible=true
end)
MiniBtnHit.MouseButton1Click:Connect(function()
    MiniBtn.Visible=false; Win.Visible=true
    Win.Size=UDim2.fromOffset(0,0)
    Win.Position=UDim2.new(0.5,0,0.5,0)
    tw(Win,0.4,{Size=UDim2.fromOffset(WIN_W,WIN_H),
        Position=UDim2.new(0.5,-WIN_W/2,0.5,-WIN_H/2)},
        Enum.EasingStyle.Back):Play()
end)

-- ── Body ──────────────────────────────────────────────────────────────
local Body=Instance.new("Frame",Win)
Body.Size=UDim2.new(1,-px(16),1,-(TITLE_H+px(8)))
Body.Position=UDim2.fromOffset(px(8),TITLE_H+px(6))
Body.BackgroundTransparency=1

local LCol=Instance.new("Frame",Body)
LCol.Size=UDim2.new(0,LEFT_W,1,0); LCol.BackgroundTransparency=1

local Div=Instance.new("Frame",Body)
Div.Size=UDim2.new(0,px(1),1,-px(4))
Div.Position=UDim2.fromOffset(LEFT_W+px(4),px(2))
Div.BackgroundColor3=C.strokeHi; Div.BackgroundTransparency=0.6
Div.BorderSizePixel=0

local RCol=Instance.new("Frame",Body)
RCol.Size=UDim2.new(0,RIGHT_W-px(8),1,0)
RCol.Position=UDim2.fromOffset(LEFT_W+px(10),0)
RCol.BackgroundTransparency=1

-- ── Tab Bar ───────────────────────────────────────────────────────────
local TABS={"Animations","My Sets","Current"}
local tabBtns={}

local TabBar=Instance.new("Frame",LCol)
TabBar.Size=UDim2.new(1,0,0,px(32))
TabBar.BackgroundColor3=C.bg2
TabBar.BorderSizePixel=0; mkCorner(TabBar,px(10))
mkStroke(TabBar,C.stroke,1,0.5)

local tabGrid=Instance.new("UIGridLayout",TabBar)
tabGrid.CellSize=UDim2.new(1/#TABS,-px(4),1,-px(6))
tabGrid.CellPadding=UDim2.fromOffset(px(3),0)
tabGrid.HorizontalAlignment=Enum.HorizontalAlignment.Center
tabGrid.VerticalAlignment=Enum.VerticalAlignment.Center

for _,name in ipairs(TABS) do
    local tb=Instance.new("TextButton",TabBar)
    tb.BackgroundColor3=C.bg2; tb.TextColor3=C.textLo
    tb.Text=name; tb.Font=Enum.Font.GothamBold; tb.TextSize=px(10)
    tb.AutoButtonColor=false; tb.ClipsDescendants=true
    mkCorner(tb,px(7)); tabBtns[name]=tb
end

local activeTabGlow=nil
local function setTab(name)
    S.tab=name
    for n,tb in pairs(tabBtns) do
        local isActive=(n==name)
        tw(tb,0.2,{
            BackgroundColor3=isActive and C.neon or C.bg2,
            TextColor3=isActive and C.white or C.textLo,
        }):Play()
    end
end
